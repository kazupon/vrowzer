{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "promise", "unicorn", "node"],
  "extends": ["./node_modules/@kazupon/eslint-plugin/oxlint/recommended.json"],
  "overrides": [
    {
      "files": ["**/*.{test,spec}.{ts,tsx}"],
      "plugins": ["vitest"]
    },
    {
      "files": [
        "**/*.md",
        "**/*.md/**/*.{js,mjs,cjs,ts,mts,cts,jsx,tsx}",
        "**/*.config.{js,mjs,cjs,ts,mts,cts,jsx,tsx}",
        "**/*.{test,spec}.{js,mjs,cjs,ts,mts,cts,jsx,tsx}",
        "**/*.e2e-{test,spec}.{js,mjs,cjs,ts,mts,cts,jsx,tsx}",
        "**/*.browser-{test,spec}.{js,mjs,cjs,ts,mts,cts,jsx,tsx}",
        "**/*.{test,spec}-d.{js,mjs,cjs,ts,mts,cts,jsx,tsx}",
        "**/*.browser-{test,spec}-d.{js,mjs,cjs,ts,mts,cts,jsx,tsx}",
        "scripts/*.{js,mjs,cjs,ts,mts,cts,jsx,tsx}",
        "packages/{service-worker,unplugin-service-worker}/{playground,e2e,test-public}/**/*.{js,mjs,cjs,ts,mts,cts,jsx,tsx}"
      ],
      "rules": {
        "@kazupon/enforce-header-comment": "off"
      }
    },
    {
      "files": ["**/*.{js,mjs,cjs,ts,mts,cts,jsx,tsx}"],
      "rules": {
        "@kazupon/no-tag-comments": [
          "warn",
          {
            "tags": ["TODO", "FIXME", "BUG"]
          }
        ]
      }
    }
  ],
  "ignorePatterns": [
    "**/dist",
    "**/.output",
    ".vscode/**/*.json",
    "**/*.html",
    "**/tsconfig*.json",
    "**/__screenshots__",
    "packages/**/docs/**",
    "refers/**",
    "packages/playground/src/**",
    "packages/memfs-test/src/**",
    "packages/svc-sandbox/**",
    "packages/vrowser/src/**"
  ]
}
