{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "promise", "unicorn", "node", "regex"],
  "overrides": [
    {
      "files": ["**/*.{test,spec}.{ts,tsx}"],
      "plugins": ["vitest"]
    }
  ],
  "ignorePatterns": [
    "**/node_modules",
    "**/dist",
    ".vscode/**/*.json",
    "**/*.html",
    "**/tsconfig*.json",
    "tsconfig.json",
    "vite/**",
    "rolldown/**",
    "oxc/**",
    "rs-napi/**",
    "packages/playground/src/**",
    "packages/proto2/src/**"
  ]
}
