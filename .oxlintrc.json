{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "promise", "unicorn", "node"],
  "extends": ["./node_modules/@kazupon/eslint-plugin/oxlint/recommended.json"],
  "rules": {
    "curly": "error"
  },
  "overrides": [
    {
      "files": ["**/*.{test,spec}.{ts,tsx}"],
      "plugins": ["vitest"]
    },
    {
      "files": [
        "**/*.md",
        "**/*.md/**/*.{js,mjs,cjs,ts,mts,cts,jsx,tsx}",
        "**/*.config.{js,mjs,cjs,ts,mts,cts,jsx,tsx}",
        "**/*.{test,spec}.{js,mjs,cjs,ts,mts,cts,jsx,tsx}",
        "**/*.e2e-{test,spec}.{js,mjs,cjs,ts,mts,cts,jsx,tsx}",
        "**/*.browser-{test,spec}.{js,mjs,cjs,ts,mts,cts,jsx,tsx}",
        "**/*.{test,spec}-d.{js,mjs,cjs,ts,mts,cts,jsx,tsx}",
        "**/*.browser-{test,spec}-d.{js,mjs,cjs,ts,mts,cts,jsx,tsx}",
        "scripts/*.{js,mjs,cjs,ts,mts,cts,jsx,tsx}",
        "packages/vite-dev-server/{src,types,misc}/**/*.{js,mjs,cjs,ts,mts,cts,jsx,tsx}",
        "packages/vite-dev-server/client.d.ts",
        "packages/{service-worker,unplugin-service-worker,service-worker-server}/{playground,e2e,test-public}/**/*.{js,mjs,cjs,ts,mts,cts,jsx,tsx}",
        "e2e/**/*.{js,mjs,cjs,ts,mts,cts,jsx,tsx}"
      ],
      "rules": {
        "@kazupon/enforce-header-comment": "off"
      }
    },
    {
      "files": ["packages/vite-dev-server/**/*.{ts,mts,cts,tsx}"],
      "rules": {
        "@typescript-eslint/triple-slash-reference": "off"
      }
    },
    {
      "files": ["**/*.{js,mjs,cjs,ts,mts,cts,jsx,tsx}"],
      "rules": {
        "@kazupon/no-tag-comments": [
          "warn",
          {
            "tags": ["TODO", "FIXME", "BUG"]
          }
        ]
      }
    }
  ],
  "ignorePatterns": [
    ".playwright-cli",
    ".vscode/**/*.json",
    ".claude/**/*.md",
    "packages/node-polyfill/**/*.test.{js,mjs,cjs,ts,mts,cts,jsx,tsx}",
    "**/dist",
    "**/.output",
    "**/.output-shared",
    "**/.notes",
    "**/.diff",
    "**/*.html",
    "**/tsconfig*.json",
    "**/__screenshots__",
    "e2e/fixtures/**",
    "packages/**/docs/**",
    "refers/**",
    "packages/play-vrowser/**"
  ]
}
