{
  "name": "@vrowser/service-worker",
  "description": "Safely deploy and manage Service Workers with version control, bidirectional communication, and emergency shutdown capabilities",
  "version": "0.0.0",
  "author": {
    "name": "kazuya kawaguchi",
    "email": "kawakazu80@gmail.com"
  },
  "license": "MIT",
  "funding": "https://github.com/sponsors/kazupon",
  "bugs": {
    "url": "https://github.com/kazupon/vrowser/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kazupon/vrowser.git",
    "directory": "packages/service-worker"
  },
  "keywords": [
    "service-worker",
    "utils",
    "util"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">= 20.19.0"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    "./admin": {
      "types": "./dist/admin.d.ts",
      "import": "./dist/admin.js"
    },
    "./controller": {
      "types": "./dist/controller.d.ts",
      "import": "./dist/controller.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./protocols": {
      "types": "./dist/protocols.d.ts",
      "import": "./dist/protocols.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*",
        "./*"
      ]
    }
  },
  "scripts": {
    "build": "tsdown",
    "build:docs": "typedoc --excludeInternal",
    "e2e": "playwright test",
    "prepack": "pnpm build",
    "test": "cd ../.. && vitest run --project service-worker"
  },
  "devDependencies": {
    "@kazupon/jts-utils": "^0.11.0",
    "@playwright/test": "^1.50.0",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typedoc": "catalog:",
    "typedoc-plugin-markdown": "catalog:",
    "vite": "^6.3.0"
  }
}
