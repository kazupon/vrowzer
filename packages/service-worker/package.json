{
  "name": "@vrowzer/service-worker",
  "description": "Safely deploy and manage Service Workers with version control, bidirectional communication, and emergency shutdown capabilities",
  "version": "0.0.0",
  "author": {
    "name": "kazuya kawaguchi",
    "email": "kawakazu80@gmail.com"
  },
  "license": "MIT",
  "funding": "https://github.com/sponsors/kazupon",
  "bugs": {
    "url": "https://github.com/kazupon/vrowzer/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kazupon/vrowzer.git",
    "directory": "packages/service-worker"
  },
  "keywords": [
    "service-worker",
    "utils",
    "util"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">= 20.19.0"
  },
  "type": "module",
  "files": [
    "dist",
    "docs"
  ],
  "exports": {
    "./admin": {
      "types": "./dist/admin.d.ts",
      "import": "./dist/admin.js"
    },
    "./controller": {
      "types": "./dist/controller.d.ts",
      "import": "./dist/controller.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./protocols": {
      "types": "./dist/protocols.d.ts",
      "import": "./dist/protocols.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*",
        "./*"
      ]
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "vp pack",
    "build:docs": "tsx ../../scripts/api-references.ts",
    "play": "vp dev --config vite.config.ts",
    "play:build": "vp build --config vite.config.ts",
    "play:preview": "vp preview --config vite.config.ts",
    "prepack": "vp run build"
  },
  "devDependencies": {
    "@kazupon/jts-utils": "catalog:",
    "@playwright/test": "catalog:",
    "@vrowzer/unplugin-service-worker": "workspace:*",
    "publint": "catalog:",
    "vite": "catalog:"
  }
}
