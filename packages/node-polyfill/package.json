{
  "name": "@vrowzer/node-polyfill",
  "description": "Browser-compatible Node.js module polyfills for vrowzer",
  "version": "0.1.2",
  "author": {
    "name": "kazuya kawaguchi",
    "email": "kawakazu80@gmail.com"
  },
  "license": "MIT",
  "funding": "https://github.com/sponsors/kazupon",
  "bugs": {
    "url": "https://github.com/kazupon/vrowzer/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kazupon/vrowzer.git",
    "directory": "packages/node-polyfill"
  },
  "keywords": [
    "polyfill",
    "node",
    "browser",
    "vrowzer"
  ],
  "homepage": "https://github.com/kazupon/vrowzer/tree/main/packages/node-polyfill#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">= 20.19.0"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    "./url": {
      "types": "./dist/url.d.ts",
      "import": "./dist/url.js",
      "default": "./dist/url.js"
    },
    "./util": {
      "types": "./dist/util.d.ts",
      "import": "./dist/util.js",
      "default": "./dist/util.js"
    },
    "./events": {
      "types": "./dist/events.d.ts",
      "import": "./dist/events.js",
      "default": "./dist/events.js"
    },
    "./perf_hooks": {
      "types": "./dist/perf_hooks.d.ts",
      "import": "./dist/perf_hooks.js",
      "default": "./dist/perf_hooks.js"
    },
    "./os": {
      "types": "./dist/os.d.ts",
      "import": "./dist/os.js",
      "default": "./dist/os.js"
    },
    "./dns": {
      "types": "./dist/dns.d.ts",
      "import": "./dist/dns.js",
      "default": "./dist/dns.js"
    },
    "./dns/promises": {
      "types": "./dist/dns_promises.d.ts",
      "import": "./dist/dns_promises.js",
      "default": "./dist/dns_promises.js"
    },
    "./process": {
      "types": "./dist/process.d.ts",
      "import": "./dist/process.js",
      "default": "./dist/process.js"
    },
    "./readline": {
      "types": "./dist/readline.d.ts",
      "import": "./dist/readline.js",
      "default": "./dist/readline.js"
    },
    "./timers": {
      "types": "./dist/timers.d.ts",
      "import": "./dist/timers.js",
      "default": "./dist/timers.js"
    },
    "./timers/promises": {
      "types": "./dist/timers_promises.d.ts",
      "import": "./dist/timers_promises.js",
      "default": "./dist/timers_promises.js"
    },
    "./crypto": {
      "types": "./dist/crypto.d.ts",
      "import": "./dist/crypto.js",
      "default": "./dist/crypto.js"
    },
    "./tty": {
      "types": "./dist/tty.d.ts",
      "import": "./dist/tty.js",
      "default": "./dist/tty.js"
    },
    "./module": {
      "types": "./dist/module.d.ts",
      "import": "./dist/module.js",
      "default": "./dist/module.js"
    },
    "./net": {
      "types": "./dist/net.d.ts",
      "import": "./dist/net.js",
      "default": "./dist/net.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "prepack": "vp run build",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/readable-stream": "^4.0.23",
    "premove": "^4.0.0",
    "publint": "catalog:",
    "readable-stream": "catalog:"
  }
}
