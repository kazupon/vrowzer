{
  "name": "@vrowzer/vite-plugin",
  "description": "Vite plugin for vrowzer",
  "version": "0.0.0",
  "author": {
    "name": "kazuya kawaguchi",
    "email": "kawakazu80@gmail.com"
  },
  "license": "MIT",
  "funding": "https://github.com/sponsors/kazupon",
  "bugs": {
    "url": "https://github.com/kazupon/vrowzer/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kazupon/vrowzer.git",
    "directory": "packages/vite-plugin"
  },
  "keywords": [
    "vrowzer",
    "vite"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">= 20.19.0"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./manifest-generate": {
      "types": "./dist/manifest-generate.d.mts",
      "import": "./dist/manifest-generate.mjs"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*",
        "./*"
      ]
    }
  },
  "scripts": {
    "build": "vp pack && pnpm build:ide",
    "build:ide": "vp build --config vite.ide.config.ts",
    "prepack": "pnpm build",
    "typecheck": "tsgo --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@rollup/plugin-inject": "^5.0.5",
    "@vrowzer/fs": "workspace:*",
    "@vrowzer/node-polyfill": "workspace:*",
    "@vrowzer/rolldown": "workspace:*",
    "@vrowzer/unplugin-service-worker": "workspace:*",
    "birpc": "^2.3.0",
    "buffer": "catalog:",
    "obug": "catalog:",
    "pathe": "catalog:",
    "readable-stream": "catalog:",
    "rolldown": "catalog:",
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "@vrowzer/vite-dev-server": "workspace:*",
    "vrowzer": "workspace:*"
  },
  "devDependencies": {
    "@iconify-icons/vscode-icons": "^1.2.29",
    "@iconify/vue": "^5.0.0",
    "@oxc-project/types": "catalog:",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-vue": "catalog:",
    "monaco-editor": "^0.55.1",
    "publint": "catalog:",
    "vite": "catalog:",
    "vue": "catalog:"
  }
}
