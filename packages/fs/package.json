{
  "name": "@vrowzer/fs",
  "description": "Browser-compatible filesystem using memfs for vrowzer",
  "version": "0.0.0",
  "author": {
    "name": "kazuya kawaguchi",
    "email": "kawakazu80@gmail.com"
  },
  "license": "MIT",
  "funding": "https://github.com/sponsors/kazupon",
  "bugs": {
    "url": "https://github.com/kazupon/vrowzer/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kazupon/vrowzer.git",
    "directory": "packages/fs"
  },
  "keywords": [
    "filesystem",
    "memfs",
    "vrowzer",
    "browser"
  ],
  "homepage": "https://github.com/kazupon/vrowzer/packages/fs/README.md",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">= 20.19.0"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./promises": {
      "types": "./dist/promises.d.mts",
      "import": "./dist/promises.mjs",
      "default": "./dist/promises.mjs"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js",
      "default": "./dist/browser/index.js"
    },
    "./browser/promises": {
      "types": "./dist/browser/promises.d.ts",
      "import": "./dist/browser/promises.js",
      "default": "./dist/browser/promises.js"
    },
    "./watcher": {
      "types": "./dist/watcher/index.d.mts",
      "import": "./dist/watcher/index.mjs",
      "default": "./dist/watcher/index.mjs"
    },
    "./browser/watcher": {
      "types": "./dist/browser/watcher/index.d.ts",
      "import": "./dist/browser/watcher/index.js",
      "default": "./dist/browser/watcher/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "vp pack",
    "build:docs": "tsx ../../scripts/api-references.ts",
    "prepack": "vp run build"
  },
  "dependencies": {
    "@jsonjoy.com/fs-core": "4.56.10",
    "@jsonjoy.com/fs-node": "4.56.10",
    "@jsonjoy.com/fs-node-utils": "4.56.10",
    "memfs": "4.56.10"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@vrowzer/node-polyfill": "workspace:*",
    "buffer": "catalog:",
    "pathe": "catalog:",
    "premove": "^4.0.0",
    "publint": "catalog:",
    "readable-stream": "catalog:",
    "vite": "catalog:"
  }
}
