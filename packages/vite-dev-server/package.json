{
  "name": "@vrowser/vite-dev-server",
  "description": "Vite dev server for vrowser",
  "version": "0.0.0",
  "author": {
    "name": "kazuya kawaguchi",
    "email": "kawakazu80@gmail.com"
  },
  "license": "MIT",
  "funding": "https://github.com/sponsors/kazupon",
  "bugs": {
    "url": "https://github.com/kazupon/vrowser/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kazupon/vrowser.git",
    "directory": "packages/vite-dev-server"
  },
  "keywords": [
    "vite",
    "dev-server",
    "frontend",
    "framework",
    "hmr",
    "vrowser",
    "build-tool",
    "browser"
  ],
  "homepage": "https://github.com/kazupon/vrowser/packages/vite-dev-server/README.md",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">= 20.19.0"
  },
  "type": "module",
  "files": [
    "bin",
    "client.d.ts",
    "dist",
    "misc/**/*.js",
    "types"
  ],
  "exports": {
    ".": "./dist/node/index.js",
    "./client": {
      "types": "./client.d.ts"
    },
    "./module-runner": "./dist/node/module-runner.js",
    "./internal": "./dist/node/internal.js",
    "./dist/client/*": "./dist/client/*",
    "./types/*": {
      "types": "./types/*"
    },
    "./types/internal/*": null,
    "./package.json": "./package.json"
  },
  "imports": {
    "#module-sync-enabled": {
      "module-sync": "./misc/true.js",
      "default": "./misc/false.js"
    },
    "#types/*": "./types/*.d.ts",
    "#dep-types/*": "./src/types/*.d.ts"
  },
  "scripts": {
    "build": "premove dist && pnpm build-bundle && pnpm build-types",
    "build-bundle": "rolldown --config rolldown.config.ts",
    "build-types": "pnpm build-types-roll && pnpm build-types-check",
    "build-types-check": "echo 'build-types-check'",
    "build-types-roll": "rolldown --config rolldown.dts.config.ts",
    "dev": "premove dist && pnpm build-bundle -w",
    "test": "vitest run --project vite-dev-server:unit",
    "test:watch": "vitest watch --project vite-dev-server:unit"
  },
  "dependencies": {
    "rolldown": "catalog:"
  },
  "devDependencies": {
    "@vrowser/node-polyfill": "workspace:*",
    "@vrowser/fs": "workspace:*",
    "@babel/parser": "^7.28.6",
    "@jridgewell/remapping": "^2.3.5",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@kazupon/jts-utils": "catalog:",
    "@noble/hashes": "^2.0.1",
    "@oxc-parser/binding-wasm32-wasi": "0.111.0",
    "@oxc-project/types": "0.108.0",
    "@rolldown/pluginutils": "1.0.0-beta.60",
    "@rollup/plugin-alias": "^5.1.1",
    "@rollup/pluginutils": "^5.3.0",
    "@types/convert-source-map": "^2.0.3",
    "@types/estree": "^1.0.8",
    "@types/picomatch": "^4.0.2",
    "@types/escape-html": "^1.0.4",
    "@vrowser/service-worker": "workspace:*",
    "@vrowser/service-worker-server": "workspace:*",
    "@vrowser/unplugin-service-worker": "workspace:*",
    "escape-html": "^1.0.3",
    "convert-source-map": "^2.0.0",
    "dotenv": "^17.2.3",
    "dotenv-expand": "^12.0.3",
    "es-module-lexer": "^1.7.0",
    "esbuild": "^0.27.2",
    "estree-walker": "^3.0.3",
    "hono": "^4.7.10",
    "magic-string": "catalog:",
    "mlly": "^1.8.0",
    "parse5": "^8.0.0",
    "nanoid": "^5.1.6",
    "obug": "^2.1.1",
    "oxc-parser": "0.111.0",
    "pathe": "^2.0.3",
    "picocolors": "^1.1.1",
    "picomatch": "^4.0.3",
    "postcss": "^8.5.6",
    "premove": "^4.0.0",
    "resolve.exports": "^2.0.3",
    "rolldown-plugin-dts": "^0.20.0",
    "strip-literal": "^3.1.0",
    "tinyglobby": "^0.2.15",
    "tsconfck": "^3.1.6",
    "ufo": "^1.6.2",
    "vite": "catalog:"
  }
}
