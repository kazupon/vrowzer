{
  "name": "@vrowzer/vite-dev-server",
  "description": "Vite dev server for vrowzer",
  "version": "0.1.4",
  "author": {
    "name": "kazuya kawaguchi",
    "email": "kawakazu80@gmail.com"
  },
  "license": "MIT",
  "funding": "https://github.com/sponsors/kazupon",
  "bugs": {
    "url": "https://github.com/kazupon/vrowzer/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kazupon/vrowzer.git",
    "directory": "packages/vite-dev-server"
  },
  "keywords": [
    "vite",
    "dev-server",
    "frontend",
    "framework",
    "hmr",
    "vrowzer",
    "build-tool",
    "browser"
  ],
  "homepage": "https://github.com/kazupon/vrowzer/tree/main/packages/vite-dev-server#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">= 20.19.0"
  },
  "type": "module",
  "files": [
    "client.d.ts",
    "dist",
    "misc/**/*.js",
    "types"
  ],
  "exports": {
    "./client": {
      "types": "./client.d.ts"
    },
    "./module-runner": "./dist/node/module-runner.js",
    "./internal": "./dist/node/internal.js",
    "./dist/client/*": "./dist/client/*",
    "./types/*": {
      "types": "./types/*"
    },
    "./types/internal/*": null,
    "./web-worker": {
      "types": "./dist/node/web-worker.d.ts",
      "default": "./dist/node/web-worker.js"
    },
    "./transformer": {
      "types": "./dist/node/transformer.d.ts",
      "default": "./dist/node/transformer.js"
    },
    "./service-worker": {
      "types": "./dist/node/service-worker.d.ts",
      "default": "./dist/node/service-worker.js"
    },
    "./vite": {
      "types": "./dist/node/vite.d.ts",
      "default": "./dist/node/vite.js"
    },
    "./messages": {
      "types": "./dist/shared/messages.d.ts",
      "default": "./dist/shared/messages.js"
    },
    "./package.json": "./package.json"
  },
  "imports": {
    "#module-sync-enabled": {
      "module-sync": "./misc/true.js",
      "default": "./misc/false.js"
    },
    "#types/*": "./types/*.d.ts",
    "#dep-types/*": "./src/types/*.d.ts"
  },
  "scripts": {
    "typecheck": "tsc6 --noEmit -p tsconfig.json",
    "build": "premove dist && vp run build-bundle && vp run build-types",
    "build-bundle": "rolldown --config rolldown.config.ts",
    "build-types": "vp run build-types-roll && vp run build-types-messages && vp run build-types-check",
    "build-types-messages": "tsc6 --ignoreConfig src/shared/messages.ts --declaration --emitDeclarationOnly --outDir dist/shared --skipLibCheck",
    "build-types-check": "echo 'build-types-check'",
    "build-types-roll": "rolldown --config rolldown.dts.config.ts",
    "dev": "premove dist && vp run build-bundle --watch",
    "prepack": "vp run build",
    "test": "vp test run --root ../.. --project vite-dev-server:unit:node",
    "test:watch": "vp test watch --root ../.. --project vite-dev-server:unit:node"
  },
  "dependencies": {
    "@vrowzer/fs": "workspace:*",
    "@vrowzer/service-worker-server": "workspace:*",
    "birpc": "^4.0.0",
    "hono": "^4.12.32",
    "pathe": "catalog:",
    "postcss": "^8.5.6",
    "rolldown": "catalog:"
  },
  "peerDependencies": {
    "@types/node": "^20.19.0 || >=22.12.0",
    "esbuild": "^0.27.0 || ^0.28.0",
    "less": "^4.0.0",
    "lightningcss": "^1.30.2",
    "sass": "^1.70.0",
    "sass-embedded": "^1.70.0",
    "stylus": ">=0.54.8",
    "terser": "^5.16.0"
  },
  "peerDependenciesMeta": {
    "@types/node": {
      "optional": true
    },
    "esbuild": {
      "optional": true
    },
    "less": {
      "optional": true
    },
    "lightningcss": {
      "optional": true
    },
    "sass": {
      "optional": true
    },
    "sass-embedded": {
      "optional": true
    },
    "stylus": {
      "optional": true
    },
    "terser": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/parser": "^7.28.6",
    "@jridgewell/remapping": "^2.3.5",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@kazupon/jts-utils": "catalog:",
    "@noble/hashes": "^2.0.1",
    "@oxc-parser/binding-wasm32-wasi": "0.111.0",
    "@oxc-project/types": "catalog:",
    "@rolldown/pluginutils": "1.0.0-beta.60",
    "@rollup/plugin-alias": "^5.1.1",
    "@rollup/pluginutils": "^5.3.0",
    "@types/convert-source-map": "^2.0.3",
    "@types/escape-html": "^1.0.4",
    "@types/estree": "^1.0.8",
    "@types/picomatch": "^4.0.2",
    "@vitest/utils": "4.1.11",
    "@vrowzer/node-polyfill": "workspace:*",
    "@vrowzer/rolldown": "workspace:*",
    "@vrowzer/safe-port": "workspace:*",
    "@vrowzer/service-worker": "workspace:*",
    "@vrowzer/unplugin-service-worker": "workspace:*",
    "buffer": "catalog:",
    "convert-source-map": "^2.0.0",
    "dotenv": "^17.2.3",
    "dotenv-expand": "^12.0.3",
    "es-module-lexer": "^1.7.0",
    "esbuild": "catalog:",
    "escape-html": "^1.0.3",
    "estree-walker": "^3.0.3",
    "less": "^4.0.0",
    "lightningcss": "^1.30.2",
    "magic-string": "catalog:",
    "mlly": "^1.8.0",
    "mrmime": "^2.0.1",
    "nanoid": "^5.1.6",
    "obug": "catalog:",
    "oxc-parser": "0.111.0",
    "parse5": "^8.0.0",
    "picocolors": "^1.1.1",
    "picomatch": "^4.0.3",
    "postcss-import": "^16.1.1",
    "postcss-load-config": "^6.0.1",
    "postcss-modules": "^6.0.1",
    "premove": "^4.0.0",
    "resolve.exports": "^2.0.3",
    "rolldown-plugin-dts": "^0.22.5",
    "sass": "^1.70.0",
    "sass-embedded": "^1.70.0",
    "strip-literal": "^3.1.0",
    "stylus": ">=0.54.8",
    "terser": "^5.16.0",
    "tinyglobby": "^0.2.15",
    "tsconfck": "^3.1.6",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "ufo": "^1.6.2",
    "vite": "catalog:"
  }
}
