{
  "name": "@vrowzer/rolldown",
  "description": "Pre-bundled @rolldown/browser for easy browser usage",
  "version": "0.1.0-beta.0",
  "author": {
    "name": "kazuya kawaguchi",
    "email": "kawakazu80@gmail.com"
  },
  "license": "MIT",
  "funding": "https://github.com/sponsors/kazupon",
  "bugs": {
    "url": "https://github.com/kazupon/vrowzer/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kazupon/vrowzer.git",
    "directory": "packages/rolldown"
  },
  "keywords": [
    "rolldown",
    "browser",
    "wasm",
    "bundler",
    "vrowzer"
  ],
  "homepage": "https://github.com/kazupon/vrowzer/tree/main/packages/rolldown#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">= 20.19.0"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./experimental": {
      "types": "./dist/experimental.d.ts",
      "import": "./dist/experimental.js",
      "default": "./dist/experimental.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js",
      "default": "./dist/browser/index.js"
    },
    "./browser/experimental": {
      "types": "./dist/browser/experimental.d.ts",
      "import": "./dist/browser/experimental.js",
      "default": "./dist/browser/experimental.js"
    },
    "./parseAst": {
      "types": "./dist/parseAst.d.ts",
      "import": "./dist/parseAst.js",
      "default": "./dist/parseAst.js"
    },
    "./browser/parseAst": {
      "types": "./dist/browser/parseAst.d.ts",
      "import": "./dist/browser/parseAst.js",
      "default": "./dist/browser/parseAst.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.js",
      "default": "./dist/utils.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "premove dist && rolldown -c rolldown.config.ts",
    "prepack": "vp run build",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@rolldown/browser": "catalog:",
    "@vrowzer/fs": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@vrowzer/node-polyfill": "workspace:*",
    "@vrowzer/service-worker": "workspace:*",
    "@vrowzer/unplugin-service-worker": "workspace:*",
    "buffer": "catalog:",
    "get-port-please": "catalog:",
    "pathe": "catalog:",
    "premove": "^4.0.0",
    "readable-stream": "catalog:",
    "rolldown": "catalog:",
    "vite": "catalog:"
  }
}
