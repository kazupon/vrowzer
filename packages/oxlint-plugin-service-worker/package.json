{
  "name": "@vrowzer/oxlint-plugin-service-worker",
  "description": "oxlint plugin for @vrowzer/service-worker",
  "version": "0.1.3",
  "author": {
    "name": "kazuya kawaguchi",
    "email": "kawakazu80@gmail.com"
  },
  "license": "MIT",
  "funding": "https://github.com/sponsors/kazupon",
  "bugs": {
    "url": "https://github.com/kazupon/vrowzer/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kazupon/vrowzer.git",
    "directory": "packages/oxlint-plugin-service-worker"
  },
  "keywords": [
    "lint",
    "oxlint",
    "service-worker",
    "vrowzer"
  ],
  "homepage": "https://github.com/kazupon/vrowzer/tree/main/packages/oxlint-plugin-service-worker#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*.d.mts",
        "./*"
      ]
    }
  },
  "scripts": {
    "_disable:typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "vp pack",
    "prepack": "vp run build"
  },
  "dependencies": {
    "@oxlint/plugins": "catalog:"
  },
  "devDependencies": {
    "oxlint": "catalog:",
    "publint": "catalog:"
  }
