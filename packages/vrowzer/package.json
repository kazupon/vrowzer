{
  "name": "vrowzer",
  "description": "Embeddable live preview system with HMR, powered by Vite dev server in the browser",
  "version": "0.0.0",
  "author": {
    "name": "kazuya kawaguchi",
    "email": "kawakazu80@gmail.com"
  },
  "license": "MIT",
  "funding": "https://github.com/sponsors/kazupon",
  "bugs": {
    "url": "https://github.com/kazupon/vrowzer/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kazupon/vrowzer.git",
    "directory": "packages/vrowzer"
  },
  "keywords": [
    "preview",
    "hmr",
    "vite"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">= 20.19.0"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./web-worker": "./dist/web-worker.ts",
    "./web-worker-core": "./dist/web-worker-core.ts",
    "./service-worker": "./dist/service-worker.ts",
    "./service-worker-core": "./dist/service-worker-core.ts",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*",
        "./*"
      ]
    }
  },
  "scripts": {
    "build": "vp pack",
    "build:docs": "typedoc --excludeInternal",
    "prepack": "pnpm build",
    "typecheck": "tsgo --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@kazupon/jts-utils": "catalog:",
    "@vrowzer/fs": "workspace:*",
    "@vrowzer/service-worker": "workspace:*",
    "@vrowzer/vite-dev-server": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@vrowzer/vite-plugin": "workspace:*",
    "get-port-please": "catalog:",
    "publint": "catalog:",
    "typedoc": "catalog:",
    "typedoc-plugin-markdown": "catalog:",
    "vite": "catalog:"
  }
}
