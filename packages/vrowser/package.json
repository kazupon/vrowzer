{
  "name": "vrowser",
  "description": "Preview with Vite HMR flavor for the browser",
  "version": "0.0.1",
  "author": {
    "name": "kazuya kawaguchi",
    "email": "kawakazu80@gmail.com"
  },
  "license": "MIT",
  "funding": "https://github.com/sponsors/kazupon",
  "bugs": {
    "url": "https://github.com/kazupon/vrowser/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kazupon/vrowser.git",
    "directory": "packages/vrowser"
  },
  "keywords": [
    "preview",
    "hmr",
    "vite"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">= 20.19.0"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*",
        "./*"
      ]
    }
  },
  "scripts": {
    "build": "tsdown",
    "build:docs": "typedoc --excludeInternal",
    "prepack": "pnpm build",
    "typecheck": "tsgo --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@vrowser/fs": "workspace:*",
    "@vrowser/service-worker": "workspace:*",
    "@vrowser/vite-dev-server": "workspace:*"
  },
  "devDependencies": {
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typedoc": "catalog:",
    "typedoc-plugin-markdown": "catalog:"
  }
}
