{
  "name": "@vrowzer/service-worker-server",
  "description": "Serverized service worker with the Node Server interface",
  "version": "0.1.1",
  "author": {
    "name": "kazuya kawaguchi",
    "email": "kawakazu80@gmail.com"
  },
  "license": "MIT",
  "funding": "https://github.com/sponsors/kazupon",
  "bugs": {
    "url": "https://github.com/kazupon/vrowzer/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kazupon/vrowzer.git",
    "directory": "packages/service-worker-server"
  },
  "keywords": [
    "service-worker",
    "vrowzer",
    "server"
  ],
  "homepage": "https://github.com/kazupon/vrowzer/tree/main/packages/service-worker-server#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">= 20.19.0"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*",
        "./*"
      ]
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "vp pack",
    "build:docs": "tsx ../../scripts/api-references.ts",
    "prepack": "vp run build"
  },
  "dependencies": {
    "@kazupon/jts-utils": "catalog:",
    "@vrowzer/service-worker": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "publint": "catalog:",
    "vite": "catalog:"
  }
}
