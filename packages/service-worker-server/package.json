{
  "name": "@vrowser/service-worker-server",
  "description": "Serverized service worker with the Node Server interface",
  "version": "0.0.2",
  "author": {
    "name": "kazuya kawaguchi",
    "email": "kawakazu80@gmail.com"
  },
  "license": "MIT",
  "funding": "https://github.com/sponsors/kazupon",
  "bugs": {
    "url": "https://github.com/kazupon/vrowser/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kazupon/vrowser.git",
    "directory": "packages/service-worker-server"
  },
  "keywords": [
    "service-worker",
    "vrowser",
    "server"
  ],
  "homepage": "https://github.com/kazupon/vrowser/packages/service-worker-server/README.md",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">= 20.19.0"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*",
        "./*"
      ]
    }
  },
  "scripts": {
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "build": "tsdown",
    "build:docs": "typedoc --excludeInternal",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@kazupon/jts-utils": "catalog:",
    "@vrowser/service-worker": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "get-port-please": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typedoc": "catalog:",
    "vite": "catalog:"
  }
}
