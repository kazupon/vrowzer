{
  "name": "vrowzer-monorepo",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.9.0",
  "type": "module",
  "scripts": {
    "build": "pnpm run build:oxlint && pnpm run build:polyfill && pnpm run build:port && pnpm run build:fs && pnpm run build:unplugin && pnpm run build:svc && pnpm run build:server && pnpm run build:rolldown && pnpm run build:vite && pnpm run build:vrowzer && pnpm run build:vite-plugin && pnpm run build:play && pnpm --filter example-vue build",
    "build:docs": "pnpm -r --if-present run build:docs",
    "build:fs": "pnpm --filter fs build",
    "build:oxlint": "pnpm --filter oxlint-plugin-service-worker build",
    "build:play": "pnpm --filter play-vrowzer build",
    "build:polyfill": "pnpm --filter node-polyfill build",
    "build:port": "pnpm --filter safe-port build",
    "build:rolldown": "pnpm --filter rolldown build",
    "build:server": "pnpm --filter service-worker-server build",
    "build:svc": "pnpm --filter service-worker build",
    "build:unplugin": "pnpm --filter unplugin-service-worker build",
    "build:vite": "pnpm --filter vite-dev-server build",
    "build:vite-plugin": "pnpm --filter vite-plugin build",
    "build:vrowzer": "pnpm --filter vrowzer build",
    "deploy:play": "pnpm --filter vite-dev-server build && pnpm --filter play-vrowzer build && wrangler pages deploy packages/play-vrowzer/dist --project-name=vrowzer-playground --commit-dirty=true",
    "dev:eslint": "pnpx @eslint/config-inspector --config eslint.config.ts",
    "dev:play": "pnpm --filter play-vrowzer dev",
    "dev:vite": "pnpm --filter vite-dev-server dev",
    "example:vue": "pnpm --filter example-vue dev",
    "fix": "pnpm run --color \"/^fix:/\"",
    "fix:eslint": "eslint . --fix",
    "fix:knip": "knip --fix --no-exit-code",
    "fix:oxfmt": "vp fmt",
    "fix:oxlint": "vp lint --fix",
    "gen:manifest": "tsx scripts/generate-manifest.ts",
    "gen:manifest:inspect": "tsx scripts/generate-manifest.ts --inspect",
    "gen:wasm": "tsx scripts/generate-wasm.ts",
    "lint": "pnpm run --color \"/^lint:/\"",
    "lint:eslint": "eslint . --cache",
    "lint:knip": "knip",
    "lint:oxfmt": "vp fmt --check",
    "lint:oxlint": "vp lint",
    "play:svc": "pnpm --filter service-worker play",
    "prepare": "vp config && pnpm run gen:wasm",
    "preview:play": "pnpm --filter play-vrowzer preview",
    "preview:play:wrangler": "pnpm --filter play-vrowzer preview:wrangler",
    "submodule:history": "tsx scripts/submodule-history.ts",
    "test": "pnpm run test:unit && pnpm run test:integration && pnpm run test:e2e",
    "test:e2e": "vp test run --project vrowzer:e2e",
    "test:e2e:build": "VROWZER_TEST_BUILD=1 vp test run --project vrowzer:e2e",
    "test:integration": "pnpm run --sequential \"/^test:integration:/\"",
    "test:integration:fs": "vp test run --project fs:integration",
    "test:integration:polyfill": "vp test run --project node-polyfill:integration",
    "test:integration:rolldown": "vp test run --project rolldown:integration",
    "test:integration:server": "vp test run --project service-worker-server:integration",
    "test:integration:svc": "vp test run --project service-worker:integration",
    "test:integration:unplugin": "vp test run --project unplugin-service-worker:integration",
    "test:integration:vrowzer": "vp test run --project vrowzer:integration",
    "test:unit": "vp test run --project *:unit",
    "test:unit:fs": "vp test run --project fs:unit",
    "test:unit:polyfill": "vp test run --project node-polyfill:unit",
    "test:unit:port": "vp test run --project safe-port:unit",
    "test:unit:server": "vp test run --project service-worker-server:unit",
    "test:unit:svc": "vp test run --project service-worker:unit",
    "test:unit:unplugin": "vp test run --project unplugin-service-worker:unit",
    "test:unit:vite": "pnpm run --color \"/^test:unit:vite:/\"",
    "test:unit:vite-plugin": "vp test run --project vite-plugin:unit",
    "test:unit:vite:node": "vp test run --project vite-dev-server:unit:node",
    "test:unit:vrowzer": "vp test run --project vrowzer:unit",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/markdown": "^7.5.1",
    "@kazupon/eslint-config": "^0.44.0",
    "@kazupon/eslint-plugin": "^0.7.1",
    "@kazupon/vp-config": "catalog:",
    "@playwright/test": "catalog:",
    "@types/bun": "^1.3.11",
    "@types/node": "catalog:",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260103.1",
    "@vitest/browser-playwright": "catalog:",
    "eslint": "^9.39.4",
    "eslint-plugin-jsdoc": "^61.7.1",
    "eslint-plugin-jsonc": "^2.21.1",
    "eslint-plugin-markdown-preferences": "^0.37.0",
    "eslint-plugin-yml": "^1.19.1",
    "knip": "^5.88.1",
    "rolldown": "catalog:",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "watr": "^4.2.1",
    "wrangler": "catalog:"
  }
}
