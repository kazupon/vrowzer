{
  "name": "vrowzer-monorepo",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.9.0",
  "type": "module",
  "scripts": {
    "build": "vp run build:oxlint && vp run build:polyfill && vp run build:port && vp run build:fs && vp run build:unplugin && vp run build:svc && vp run build:server && vp run build:rolldown && vp run build:vite && vp run build:vrowzer && vp run build:vite-plugin && vp run build:play && vp run example-vue#build",
    "build:docs": "vp run --filter './packages/**' --parallel --concurrency-limit 4 build:docs",
    "build:fs": "vp run fs#build",
    "build:oxlint": "vp run oxlint-plugin-service-worker#build",
    "build:play": "vp run play-vrowzer#build",
    "build:polyfill": "vp run node-polyfill#build",
    "build:port": "vp run safe-port#build",
    "build:rolldown": "vp run rolldown#build",
    "build:server": "vp run service-worker-server#build",
    "build:svc": "vp run service-worker#build",
    "build:unplugin": "vp run unplugin-service-worker#build",
    "build:vite": "vp run vite-dev-server#build",
    "build:vite-plugin": "vp run vite-plugin#build",
    "build:vrowzer": "vp run vrowzer#build",
    "check": "vp run lint && vp run typecheck",
    "deploy:play": "vp run vite-dev-server#build && vp run play-vrowzer#build && wrangler pages deploy packages/play-vrowzer/dist --project-name=vrowzer-playground --commit-dirty=true",
    "dev:play": "vp run play-vrowzer#dev",
    "dev:vite": "vp run vite-dev-server#dev",
    "example:vue": "vp run example-vue#dev",
    "fix": "vp run fix:knip && vp run fix:oxfmt && vp run fix:oxlint",
    "fix:knip": "knip --fix --no-exit-code",
    "fix:oxfmt": "vp fmt",
    "fix:oxlint": "vp lint --fix",
    "gen:manifest": "tsx scripts/generate-manifest.ts",
    "gen:manifest:e2e": "tsx scripts/generate-e2e-manifests.ts",
    "gen:manifest:inspect": "tsx scripts/generate-manifest.ts --inspect",
    "gen:wasm": "tsx scripts/generate-wasm.ts",
    "lint": "vp run lint:knip && vp run lint:oxfmt && vp run lint:oxlint",
    "lint:knip": "knip",
    "lint:oxfmt": "vp fmt --check",
    "lint:oxlint": "vp lint",
    "play:svc": "vp run service-worker#play",
    "prepare": "vp config && vp exec tsx scripts/generate-wasm.ts",
    "preview:play": "vp run play-vrowzer#preview",
    "preview:play:wrangler": "vp run play-vrowzer#preview:wrangler",
    "release": "node scripts/check-release-preconditions.mjs && bumpp \"packages/*/package.json\"",
    "release:check": "node scripts/check-release-version.mjs",
    "release:pack": "node scripts/release-npm.mjs --pack-only",
    "release:publish": "node scripts/release-npm.mjs",
    "release:smoke": "node scripts/smoke-published-packages.mjs",
    "submodule:history": "tsx scripts/submodule-history.ts",
    "test": "vp run test:unit && vp run test:integration && vp run test:e2e",
    "test:e2e": "vp run gen:manifest:e2e && vp test run --project vrowzer:e2e",
    "test:e2e:build": "vp run gen:manifest:e2e && VROWZER_TEST_BUILD=1 vp test run --project vrowzer:e2e",
    "test:integration": "vp run test:integration:fs && vp run test:integration:polyfill && vp run test:integration:rolldown && vp run test:integration:server && vp run test:integration:svc && vp run test:integration:unplugin && vp run test:integration:vrowzer",
    "test:integration:fs": "vp test run --project fs:integration",
    "test:integration:polyfill": "vp test run --project node-polyfill:integration",
    "test:integration:rolldown": "vp test run --project rolldown:integration",
    "test:integration:server": "vp test run --project service-worker-server:integration",
    "test:integration:svc": "vp test run --project service-worker:integration",
    "test:integration:unplugin": "vp test run --project unplugin-service-worker:integration",
    "test:integration:vrowzer": "vp test run --project vrowzer:integration",
    "test:unit": "vp test run --project *:unit",
    "test:unit:fs": "vp test run --project fs:unit",
    "test:unit:polyfill": "vp test run --project node-polyfill:unit",
    "test:unit:port": "vp test run --project safe-port:unit",
    "test:unit:server": "vp test run --project service-worker-server:unit",
    "test:unit:svc": "vp test run --project service-worker:unit",
    "test:unit:unplugin": "vp test run --project unplugin-service-worker:unit",
    "test:unit:vite": "vp run test:unit:vite-plugin && vp run test:unit:vite:node",
    "test:unit:vite-plugin": "vp test run --project vite-plugin:unit",
    "test:unit:vite:node": "vp test run --project vite-dev-server:unit:node",
    "test:unit:vrowzer": "vp test run --project vrowzer:unit",
    "typecheck": "vp run --filter './packages/**' --parallel --concurrency-limit 4 typecheck"
  },
  "devDependencies": {
    "@kazupon/vp-config": "catalog:",
    "@playwright/test": "catalog:",
    "@types/bun": "^1.3.11",
    "@types/node": "catalog:",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/browser-playwright": "catalog:",
    "bumpp": "catalog:",
    "es-module-lexer": "catalog:",
    "gh-changelogen": "catalog:",
    "knip": "^6.29.0",
    "semver": "catalog:",
    "tar": "catalog:",
    "tsx": "^4.21.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitepress": "catalog:",
    "vitepress-api-references": "catalog:",
    "watr": "^4.2.1",
    "wrangler": "catalog:"
  }
}
