{
  "name": "vrowser-monorepo",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.31.0",
  "type": "module",
  "scripts": {
    "build:docs": "pnpm -r run build:docs",
    "build:fs": "pnpm --filter fs build",
    "build:oxlint": "pnpm --filter oxlint-plugin-service-worker build",
    "build:play": "pnpm --filter play-vrowser build",
    "build:polyfill": "pnpm --filter node-polyfill build",
    "build:rolldown": "pnpm --filter rolldown build",
    "build:server": "pnpm --filter service-worker-server build",
    "build:svc": "pnpm --filter service-worker build",
    "build:unplugin": "pnpm --filter unplugin-service-worker build",
    "build:vite": "pnpm --filter vite-dev-server build",
    "build:vite-plugin": "pnpm --filter vite-plugin build",
    "build:vite:type": "pnpm --filter vite-dev-server build-types-roll",
    "build:vrowser": "pnpm --filter vrowser build",
    "deploy:play": "pnpm --filter play-vrowser... run build && wrangler pages deploy packages/play-vrowser/dist --project-name=vrowser-playground --commit-dirty=true",
    "dev:eslint": "pnpx @eslint/config-inspector --config eslint.config.ts",
    "dev:play": "pnpm --filter play-vrowser dev",
    "dev:vite": "pnpm --filter vite-dev-server dev",
    "fix": "pnpm run --color \"/^fix:/\"",
    "fix:eslint": "eslint . --fix",
    "fix:knip": "knip --fix --no-exit-code",
    "fix:oxfmt": "oxfmt . --config ./node_modules/@kazupon/prettier-config/index.json",
    "fix:oxlint": "oxlint --config .oxlintrc.json --type-aware --fix",
    "gen:manifest": "tsx scripts/generate-manifest.ts",
    "gen:wasm": "tsx scripts/generate-wasm.ts",
    "lint": "pnpm run --color \"/^lint:/\"",
    "lint:eslint": "eslint . --cache",
    "lint:knip": "knip",
    "lint:oxfmt": "oxfmt . --check --config ./node_modules/@kazupon/prettier-config/index.json",
    "lint:oxlint": "oxlint --type-aware --config .oxlintrc.json",
    "play:svc": "pnpm --filter service-worker play",
    "prepare": "git config --local core.hooksPath .githooks && pnpm run gen:wasm",
    "preview:play": "pnpm --filter play-vrowser preview",
    "preview:play:wrangler": "pnpm --filter play-vrowser preview:wrangler",
    "submodule:history": "tsx scripts/submodule-history.ts",
    "test": "pnpm run test:unit && pnpm run test:integration && pnpm run test:e2e",
    "test:e2e": "VROWSER_TEST_BUILD=1 vitest run --project vrowser:e2e:hosts",
    "test:integration": "pnpm run --sequential \"/^test:integration:/\"",
    "test:integration:fs": "vitest run --project fs:integration",
    "test:integration:polyfill": "vitest run --project node-polyfill:integration",
    "test:integration:rolldown": "vitest run --project rolldown:integration",
    "test:integration:server": "vitest run --project service-worker-server:integration",
    "test:integration:svc": "vitest run --project service-worker:integration",
    "test:integration:unplugin": "vitest run --project unplugin-service-worker:integration",
    "test:integration:vrowser": "vitest run --project vrowser:integration",
    "test:unit": "vitest run --project *:unit",
    "test:unit:fs": "vitest run --project fs:unit",
    "test:unit:polyfill": "vitest run --project node-polyfill:unit",
    "test:unit:server": "vitest run --project service-worker-server:unit",
    "test:unit:svc": "vitest run --project service-worker:unit",
    "test:unit:unplugin": "vitest run --project unplugin-service-worker:unit",
    "test:unit:vite": "pnpm run --color \"/^test:unit:vite:/\"",
    "test:unit:vite-plugin": "vitest run --project vite-plugin:unit",
    "test:unit:vite:node": "vitest run --project vite-dev-server:unit:node",
    "test:unit:vrowser": "vitest run --project vrowser:unit",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/markdown": "^7.5.1",
    "@kazupon/eslint-config": "^0.44.0",
    "@kazupon/eslint-plugin": "^0.7.1",
    "@kazupon/prettier-config": "^0.2.0",
    "@playwright/test": "catalog:",
    "@types/bun": "^1.3.10",
    "@types/node": "catalog:",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260103.1",
    "@vitest/browser-playwright": "^4.0.18",
    "eslint": "^9.39.4",
    "eslint-plugin-jsdoc": "^61.7.1",
    "eslint-plugin-jsonc": "^2.21.1",
    "eslint-plugin-markdown-preferences": "^0.37.0",
    "eslint-plugin-oxlint": "^1.51.0",
    "eslint-plugin-yml": "^1.19.1",
    "knip": "^5.86.0",
    "lint-staged": "^16.3.2",
    "oxfmt": "^0.35.0",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "^0.10.1",
    "rolldown": "catalog:",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "catalog:",
    "vitest": "catalog:",
    "watr": "^4.2.1",
    "wrangler": "catalog:"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@rolldown/browser",
      "core-js",
      "deno",
      "esbuild",
      "wasm-pack"
    ]
  },
  "lint-staged": {
    "*.ts?(x)": [
      "oxfmt --config ./node_modules/@kazupon/prettier-config/index.json --no-error-on-unmatched-pattern",
      "oxlint --config .oxlintrc.json --type-aware --fix"
    ],
    "*.{js,mjs,cjs}": [
      "oxfmt --config ./node_modules/@kazupon/prettier-config/index.json --no-error-on-unmatched-pattern",
      "oxlint --config .oxlintrc.json --type-aware --fix"
    ],
    "*.{json,jsonc,json5,md,yml,yaml}": [
      "oxfmt --config ./node_modules/@kazupon/prettier-config/index.json --no-error-on-unmatched-pattern",
      "eslint --fix"
    ]
  }
}
