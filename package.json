{
  "name": "rolldown-hmr-browser-monorepo",
  "private": true,
  "scripts": {
    "prepare": "git config --local core.hooksPath .githooks",
    "fix": "pnpm run --color \"/^fix:/\"",
    "fix:knip": "knip --fix --no-exit-code",
    "fix:oxlint": "oxlint --config .oxlintrc.jsonc --type-aware --fix",
    "fix:oxfmt": "oxfmt --config ./node_modules/@kazupon/prettier-config/index.json",
    "fix:prettier": "prettier --write --experimental-cli \"**/*.{json,jsonc,json5,md,yml,yaml}\"",
    "lint": "pnpm run --color \"/^lint:/\"",
    "lint:oxlint": "oxlint --config .oxlintrc.jsonc --type-aware",
    "lint:knip": "knip",
    "lint:oxfmt": "oxfmt . --check --config ./node_modules/@kazupon/prettier-config/index.json",
    "lint:prettier": "prettier --check --experimental-cli \"**/*.{json,jsonc,json5,md,yml,yaml}\"",
    "play": "pnpm --filter playground dev"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.23.0",
  "devDependencies": {
    "@kazupon/prettier-config": "^0.2.0",
    "knip": "^5.70.2",
    "lint-staged": "^16.2.3",
    "oxfmt": "^0.15.0",
    "oxlint": "^1.30.0",
    "oxlint-tsgolint": "^0.8.3",
    "prettier": "^3.6.2"
  },
  "lint-staged": {
    "*.ts?(x)": [
      "oxfmt --config ./node_modules/@kazupon/prettier-config/index.json",
      "oxlint --config .oxlintrc.jsonc --type-aware --fix"
    ],
    "*.{js,mjs,cjs}": [
      "oxfmt --config ./node_modules/@kazupon/prettier-config/index.json",
      "oxlint --config .oxlintrc.jsonc --type-aware --fix"
    ],
    "*.{json,jsonc,json5,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
